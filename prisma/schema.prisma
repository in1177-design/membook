// Schema for the "ספר זיכרון" pilot — collection tool for greeting/memory albums.
// Modeled from docs/PRD-פיילוט-איסוף-חומרים.md and docs/בריף-בנייה-פיילוט.md (v1 scope),
// with the multi-tenant seam from docs/תכנון-ארכיטקטורה-טכנית.md (organizationId on Project).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  HE
  RU
  EN
}

enum ProjectStatus {
  ACTIVE
  CLOSED
}

enum DeviceType {
  MOBILE
  DESKTOP
  UNKNOWN
}

enum AttendingStatus {
  YES
  NO
  MAYBE
}

enum QuestionMode {
  ALL      // everyone answers every question (default, existing behavior)
  PICK_ONE // each participant picks exactly one question from the pool to answer
}

// Reserved for a future B2B layer (studios/designers) sitting above projects.
// Not used in v1 — every project belongs to the single pilot operator.
model Organization {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id                 String        @id @default(cuid())
  name               String
  // Label for this shown to the admin next to "name" varies with eventType
  // (couple's names for a wedding, celebrant's name for a birthday, etc.) —
  // see celebrantLabelFor() in app/admin/projects/eventTypeEmoji.ts.
  celebrantNames     String?
  eventType          String?
  customerName       String?
  customerPhone      String?
  eventDate          DateTime?
  submissionDeadline DateTime?
  notes              String?
  coverImageUrl      String?
  // Vertical crop position (0-100) for coverImageUrl wherever it renders as
  // the mobile wave hero (object-position's Y%) — 50 is the old implicit
  // centered behavior, so existing projects are unaffected until an admin
  // adjusts it via the "התאם תמונה" control on the admin preview page.
  coverImagePositionY Int          @default(50)
  status             ProjectStatus @default(ACTIVE)
  defaultLanguage    Language      @default(HE)
  // Which languages this album actually collects/shows content in. HE is always
  // included (enforced in the admin UI, not here). Drives which languages the
  // admin can assign to an invitee — see LanguageCheckboxes.tsx (the real,
  // persisted "שפות הפרויקט" toggle) and the language gating in addInvitee/
  // updateInvitee/updateInviteeLanguage/bulkAddInvitees (lib/actions.ts).
  languages          Language[]    @default([HE])
  questionMode       QuestionMode  @default(ALL)

  // A warm, guest-facing headline shown at the top of the intro step — distinct
  // from `name` (the internal admin-facing project label). Falls back to `name`
  // when unset so existing projects keep showing what they show today.
  guestHeadlineHe String?
  guestHeadlineRu String?
  guestHeadlineEn String?

  // Shown at the top of the invitee's submission page. Per-language like
  // Question, since it's guest-facing content, not admin-only.
  introTextHe String?
  introTextRu String?
  introTextEn String?

  // Shown only in PICK_ONE mode: replaces the hardcoded photo-upload guidance
  // for that flow. Per-language, HE-fallback pattern as introText* above.
  photoRequestTextHe String?
  photoRequestTextRu String?
  photoRequestTextEn String?

  // The blessing-textarea placeholder, also PICK_ONE-only. Per-language,
  // HE-fallback pattern as introText*/photoRequestText* above.
  blessingPromptTextHe String?
  blessingPromptTextRu String?
  blessingPromptTextEn String?

  // Reusable message templates for contacting guests (composed once per
  // project, not sent automatically yet — no dispatch feature exists). Guest
  // list stays as Invitee rows; nothing per-guest is stored here. Support
  // {{guest_name}}/{{personal_link}} placeholders, substituted at send time
  // (not yet built). Per-language like introText*/blessingPromptText* above.
  whatsappTemplateHe String?
  whatsappTemplateRu String?
  whatsappTemplateEn String?

  emailSubjectTemplateHe String?
  emailSubjectTemplateRu String?
  emailSubjectTemplateEn String?

  emailBodyTemplateHe String?
  emailBodyTemplateRu String?
  emailBodyTemplateEn String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  questions Question[]
  invitees  Invitee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// A personal library of reusable question text, so future projects don't
// require retyping from scratch. Deliberately not linked to any Project or
// Organization — global to the single pilot operator, matching v1 scope.
model QuestionTemplate {
  id String @id @default(cuid())

  textHe String
  textRu String?
  textEn String?

  helperTextHe String?
  helperTextRu String?
  helperTextEn String?

  createdAt DateTime @default(now())
}

// Same idea as QuestionTemplate, for the guest-facing intro paragraph.
model IntroTemplate {
  id    String @id @default(cuid())
  label String

  textHe String
  textRu String?
  textEn String?

  createdAt DateTime @default(now())
}

// One free-text question per row so a project can hold 1..N questions (not hardcoded).
// Up to 3 manually-entered language variants per question (no machine translation),
// matching the same tone/privacy call as the future AI-editing feature.
model Question {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sortOrder Int

  textHe String
  textRu String?
  textEn String?

  helperTextHe String?
  helperTextRu String?
  helperTextEn String?

  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// A family member invited to contribute. "Second contact" fields cover couples who
// share one link — status stays at the link level, we can't tell which of the two answered.
model Invitee {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  phone    String?
  // Optional contact email — not used for auth/login and not an identifier
  // (no uniqueness constraint); purely a contact detail, same status as phone.
  email    String?
  relation String?
  language Language?

  name2  String?
  phone2 String?

  // Internal admin notes about this invitee — never shown to the guest.
  notes String?

  // RSVP status, set by the admin (not collected from the guest in v1).
  attending AttendingStatus?

  inviteLink InviteLink?
  submission Submission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// The token is split out from Invitee so a link can be revoked/regenerated without
// touching invitee history. Status (sent/opened/submitted) is derived at query time
// from sentAt / firstViewedAt / lastViewedAt / Submission.submittedAt rather than
// stored redundantly. Expiry is derived from Project.eventDate + grace window, not
// a stored TTL, so it stays correct if the event date moves.
model InviteLink {
  id        String  @id @default(cuid())
  inviteeId String  @unique
  invitee   Invitee @relation(fields: [inviteeId], references: [id], onDelete: Cascade)

  token     String    @unique
  revokedAt DateTime?

  sentAt        DateTime?
  firstViewedAt DateTime?
  lastViewedAt  DateTime?

  viewLogs ViewLog[]

  createdAt DateTime @default(now())

  @@index([token])
}

// Every hit on the public page, kept for later analysis (repeat visits vs. one-off).
// The admin table only ever surfaces first/last from InviteLink; this is raw material.
model ViewLog {
  id           String     @id @default(cuid())
  inviteLinkId String
  inviteLink   InviteLink @relation(fields: [inviteLinkId], references: [id], onDelete: Cascade)

  viewedAt   DateTime   @default(now())
  userAgent  String?
  isBot      Boolean    @default(false)
  deviceType DeviceType @default(UNKNOWN)

  @@index([inviteLinkId])
}

// One submission per invitee, created/updated incrementally as the participant
// moves through the multi-step wizard, editable until the project closes.
model Submission {
  id        String  @id @default(cuid())
  inviteeId String  @unique
  invitee   Invitee @relation(fields: [inviteeId], references: [id], onDelete: Cascade)

  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
  dateLocation String?

  // Only used in the project's PICK_ONE question mode — a free-text wish/blessing,
  // separate from the answer to the chosen question, plus who it's signed by
  // (defaults to the invitee's registered name, but editable).
  blessingText     String?
  blessingSignedBy String?

  // Admin-only supplementary text (AlbumPageView) — not tied to any of the
  // project's configured questions, so it's not part of the guest wizard's
  // own answer flow at all; only ever written via updateSubmissionAdditionalText
  // in lib/actions.ts, for a submission the admin wants to add more to
  // beyond what the guest actually answered.
  additionalText String?

  // Set only when the participant confirms the final preview step — distinguishes
  // "in progress" (autosaved along the way) from "actually done". Null means the
  // wizard should still be shown; non-null means the read-only book view should.
  completedAt DateTime?

  // Position of this spread within the finished album; set from the
  // drag-and-drop order on the "עיצוב האלבום" admin screen.
  sortOrder Int @default(0)

  answers     Answer[]
  mediaAssets MediaAsset[]
}

model Answer {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id])

  text String

  @@unique([submissionId, questionId])
  @@index([submissionId])
}

// Separate one-to-many table so a future move from "one photo" to 2-3 photos per
// submission needs no schema change.
model MediaAsset {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  cloudinaryPublicId String
  url                String
  width              Int?
  height             Int?
  format             String?

  createdAt DateTime @default(now())

  @@index([submissionId])
}
